# =============================================================================
# DOGM.AI Cohort - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Node Environment
# -----------------------------------------------------------------------------
NODE_ENV=development

# -----------------------------------------------------------------------------
# Application URL (required for CORS, email links, etc.)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# Local development (SQLite)
DATABASE_URL="file:./prisma/dev.db"

# Production (Turso)
# TURSO_DATABASE_URL="libsql://your-database.turso.io"
# TURSO_AUTH_TOKEN="your-turso-auth-token"

# -----------------------------------------------------------------------------
# Authentication (JWT)
# -----------------------------------------------------------------------------
# CRITICAL: Generate a secure secret for production!
# Run: openssl rand -base64 48
# Minimum 64 characters required in production
JWT_SECRET="your-jwt-secret-at-least-64-characters-long-for-production-use"

# -----------------------------------------------------------------------------
# Email Configuration (SMTP)
# -----------------------------------------------------------------------------
# For LOCAL DEVELOPMENT with Mailpit:
#   1. Run: docker compose up mailpit
#   2. Use these settings:
#      SMTP_HOST=localhost
#      SMTP_PORT=1025
#   3. View emails at: http://localhost:8025

# For PRODUCTION, use your SMTP provider:
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="DOGM.AI <hello@dogm.ai>"

# Production SMTP example (Namecheap PrivateEmail):
# SMTP_HOST=mail.privateemail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=hello@dogm.ai
# SMTP_PASS=your-email-password
# SMTP_FROM="DOGM.AI <hello@dogm.ai>"

# -----------------------------------------------------------------------------
# File Uploads (UploadThing)
# -----------------------------------------------------------------------------
# Get your token from: https://uploadthing.com/dashboard
UPLOADTHING_TOKEN=

# -----------------------------------------------------------------------------
# Google OAuth (Optional)
# -----------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# -----------------------------------------------------------------------------
# Rate Limiting (Production)
# -----------------------------------------------------------------------------
# For production, consider using Redis for distributed rate limiting
# REDIS_URL=redis://localhost:6379
