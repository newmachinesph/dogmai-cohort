generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                    @id @default(cuid())
  email                String                    @unique
  username             String                    @unique
  passwordHash         String?
  displayName          String?
  avatarUrl            String?
  role                 String                    @default("STUDENT")
  isActive             Boolean                   @default(true)
  mustChangePassword   Boolean                   @default(false)
  emailVerified        Boolean                   @default(false)
  emailVerifyToken     String?
  emailVerifyExpires   DateTime?
  passwordResetToken   String?
  passwordResetExpires DateTime?
  googleId             String?                   @unique
  lastLoginAt          DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  readAnnouncements    AnnouncementRead[]
  createdAnnouncements Announcement[]            @relation("CreatedBy")
  attendanceRecords    Attendance[]
  uploadedFiles        CohortFile[]              @relation("UploadedBy")
  comments             Comment[]
  conversations        ConversationParticipant[]
  enrollments          Enrollment[]
  lessonProgress       LessonProgress[]
  pinnedMessages       MessagePin[]
  messageReactions     MessageReaction[]
  messageReadReceipts  MessageReadReceipt[]
  sentMessages         Message[]                 @relation("SentMessages")
  notifications        Notification[]
  staffAssignments     StaffAssignment[]
  submissions          Submission[]
  presence             UserPresence?

  @@index([email])
  @@index([role])
  @@index([lastLoginAt])
  @@index([createdAt])
  @@index([isActive])
  @@map("users")
}

model Cohort {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  description      String?
  location         String
  mode             String            @default("HYBRID")
  startDate        DateTime
  endDate          DateTime
  maxStudents      Int               @default(25)
  status           String            @default("UPCOMING")
  isArchived       Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  announcements    Announcement[]
  assignments      Assignment[]
  files            CohortFile[]
  cohortModules    CohortModule[]
  enrollments      Enrollment[]
  sessions         Session[]
  staffAssignments StaffAssignment[]

  @@index([status])
  @@index([location])
  @@map("cohorts")
}

model Enrollment {
  id          String    @id @default(cuid())
  userId      String
  cohortId    String
  status      String    @default("ACTIVE")
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?
  cohort      Cohort    @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cohortId])
  @@index([cohortId])
  @@index([enrolledAt])
  @@index([status])
  @@map("enrollments")
}

model StaffAssignment {
  id         String   @id @default(cuid())
  userId     String
  cohortId   String
  role       String   @default("INSTRUCTOR")
  assignedAt DateTime @default(now())
  cohort     Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cohortId])
  @@index([cohortId])
  @@map("staff_assignments")
}

model Session {
  id          String       @id @default(cuid())
  cohortId    String
  title       String
  description String?
  date        DateTime
  startTime   String
  endTime     String
  mode        String       @default("HYBRID")
  location    String?
  moduleId    String?
  status      String       @default("SCHEDULED")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  attendance  Attendance[]
  module      Module?      @relation(fields: [moduleId], references: [id])
  cohort      Cohort       @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@index([cohortId, date])
  @@index([date])
  @@map("sessions")
}

model Module {
  id            String         @id @default(cuid())
  title         String
  slug          String         @unique
  description   String?
  orderIndex    Int            @default(0)
  isPublished   Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  assignments   Assignment[]
  cohortModules CohortModule[]
  lessons       Lesson[]
  sessions      Session[]

  @@index([orderIndex])
  @@map("modules")
}

model CohortModule {
  id         String    @id @default(cuid())
  cohortId   String
  moduleId   String
  startDate  DateTime?
  endDate    DateTime?
  unlockedAt DateTime?
  isLocked   Boolean   @default(true)
  orderIndex Int       @default(0)
  module     Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  cohort     Cohort    @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@unique([cohortId, moduleId])
  @@index([cohortId, orderIndex])
  @@map("cohort_modules")
}

model Lesson {
  id              String           @id @default(cuid())
  moduleId        String
  title           String
  slug            String
  description     String?
  content         String
  difficulty      String           @default("BEGINNER")
  estimatedTime   Int?
  order           Int              @default(0)
  isPublished     Boolean          @default(false)
  prerequisiteIds String?
  videoUrl        String?
  resources       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  lessonProgress  LessonProgress[]
  module          Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, slug])
  @@index([moduleId])
  @@map("lessons")
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  status      String    @default("NOT_STARTED")
  startedAt   DateTime?
  completedAt DateTime?
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@map("lesson_progress")
}

model Assignment {
  id             String       @id @default(cuid())
  cohortId       String
  moduleId       String?
  title          String
  description    String
  instructions   String
  dueDate        DateTime
  lateDeadline   DateTime?
  maxPoints      Int          @default(100)
  passingScore   Int          @default(60)
  rubric         String?
  submissionType String       @default("FILE")
  maxFileSize    Int          @default(10)
  allowedFormats String?
  isPublished    Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  module         Module?      @relation(fields: [moduleId], references: [id])
  cohort         Cohort       @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  submissions    Submission[]

  @@index([cohortId])
  @@index([dueDate])
  @@map("assignments")
}

model Submission {
  id           String     @id @default(cuid())
  assignmentId String
  userId       String
  content      String?
  fileUrl      String?
  fileName     String?
  githubUrl    String?
  status       String     @default("SUBMITTED")
  submittedAt  DateTime   @default(now())
  score        Int?
  feedback     String?
  gradedAt     DateTime?
  gradedById   String?
  comments     Comment[]
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@index([userId])
  @@index([status])
  @@index([submittedAt])
  @@index([gradedAt])
  @@map("submissions")
}

model Comment {
  id           String     @id @default(cuid())
  submissionId String
  userId       String
  content      String
  isPrivate    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("comments")
}

model CohortFile {
  id           String   @id @default(cuid())
  cohortId     String
  uploadedById String
  name         String
  fileName     String
  fileUrl      String
  fileSize     Int
  fileType     String
  category     String   @default("GENERAL")
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  uploadedBy   User     @relation("UploadedBy", fields: [uploadedById], references: [id], onDelete: Cascade)
  cohort       Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@index([cohortId])
  @@index([uploadedById])
  @@index([category])
  @@map("cohort_files")
}

model Announcement {
  id          String             @id @default(cuid())
  cohortId    String
  createdById String
  title       String
  content     String
  priority    String             @default("NORMAL")
  isPinned    Boolean            @default(false)
  isArchived  Boolean            @default(false)
  publishedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  readBy      AnnouncementRead[]
  createdBy   User               @relation("CreatedBy", fields: [createdById], references: [id])
  cohort      Cohort             @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@index([cohortId])
  @@index([publishedAt])
  @@index([isArchived])
  @@map("announcements")
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  userId         String
  readAt         DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId])
  @@map("announcement_reads")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model Conversation {
  id             String                    @id @default(cuid())
  type           String                    @default("DIRECT")
  name           String?
  avatarUrl      String?
  cohortId       String?
  createdById    String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  participants   ConversationParticipant[]
  pinnedMessages MessagePin[]
  messages       Message[]

  @@index([updatedAt])
  @@index([cohortId])
  @@map("conversations")
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  role           String       @default("MEMBER")
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?
  isTyping       Boolean      @default(false)
  typingAt       DateTime?
  isMuted        Boolean      @default(false)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String               @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  contentType    String               @default("TEXT")
  isEdited       Boolean              @default(false)
  isDeleted      Boolean              @default(false)
  fileUrl        String?
  fileName       String?
  fileSize       Int?
  fileMimeType   String?
  replyToId      String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  pins           MessagePin[]
  reactions      MessageReaction[]
  readReceipts   MessageReadReceipt[]
  replyTo        Message?             @relation("MessageReplies", fields: [replyToId], references: [id])
  replies        Message[]            @relation("MessageReplies")
  sender         User                 @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  conversation   Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([replyToId])
  @@map("messages")
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("message_reactions")
}

model MessageReadReceipt {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@map("message_read_receipts")
}

model MessagePin {
  id             String       @id @default(cuid())
  messageId      String
  conversationId String
  pinnedById     String
  pinnedAt       DateTime     @default(now())
  pinnedBy       User         @relation(fields: [pinnedById], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message        Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, conversationId])
  @@index([conversationId])
  @@map("message_pins")
}

model UserPresence {
  id         String   @id @default(cuid())
  userId     String   @unique
  status     String   @default("OFFLINE")
  lastSeenAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_presence")
}

model Attendance {
  id         String    @id @default(cuid())
  userId     String
  sessionId  String
  status     String    @default("PRESENT")
  notes      String?
  checkInAt  DateTime?
  checkOutAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  session    Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionId])
  @@index([sessionId])
  @@index([checkInAt])
  @@index([status])
  @@map("attendance")
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  type        String   @default("string")
  description String?
  category    String   @default("general")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@map("settings")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
